{
  "name": "your-player",
  "version": "1.4.4",
  "private": true,
  "description": "Your Player, a local music player for Windows with album artwork front and center.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:installer": "electron-builder --win nsis && node scripts/copy-installer.js",
    "dist:portable": "electron-builder --win portable",
    "publish:update": "node scripts/publish-update.js",
    "fetch-vendor": "node scripts/fetch-vendor.cjs",
    "release": "node scripts/fetch-vendor.cjs && node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.yourplayer.player",
    "productName": "Your Player",
    "asar": false,
    "icon": "build/icon.ico",
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "vendor/",
        "to": "vendor",
        "filter": [
          "yt-dlp.exe",
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "electron/**/*.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "uninstallDisplayName": "Your Player",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Your Player"
    }
  },
  "dependencies": {}
}
